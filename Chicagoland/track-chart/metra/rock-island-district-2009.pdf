<< /AP << /D 679 0 R /N 680 0 R >> /C [ 0 0 1 ] /CA 0.404999 /Contents (6.4.2 MOVEMENTS WITHIN CONTROL POINTS OR INTERLOCKINGS\rBLUE ISLAND INTERLOCKING - TRACK 5 - AFTER CHANGING ENDS, PASSENGER TRAINS TURNING ON TRACK 5 WITHIN BLUE ISLAND INTERLOCKING MAY ACCEPT SIGNAL INDICATION FOR EASTWARD MOVEMENT AND ARE NOT REQUIRED TO RECEIVE PERMISSION FROM THE CONTROL OPERATOR TO CHANGE DIRECTION UNLESS A MOVEABLE PART OF THE INTERLOCKING LIES BETWEEN THE EAST END OF TRAIN AND THE NEXT SIGNAL IN ADVANCE\r) /CreationDate (D:20050722110432-07'00') /F 156 /M (D:20090809131155-05'00') /NM (nDyTJowCc7NK7wI_6wgbkD) /Name /Comment /P 20 0 R /Popup 173 0 R /RC (<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:6.0.0" xfa:spec="2.0.2" ><p><span style="font-size:10.0pt;font-weight:bold">6.4.2 MOVEMENTS WITHIN CONTROL POINTS OR INTERLOCKINGS&#13;</span><span style="font-size:10.0pt">BLUE ISLAND INTERLOCKING - TRACK 5 - AFTER CHANGING ENDS, PASSENGER TRAINS TURNING ON TRACK 5 WITHIN BLUE ISLAND INTERLOCKING MAY ACCEPT SIGNAL INDICATION FOR EASTWARD MOVEMENT AND ARE NOT REQUIRED TO RECEIVE PERMISSION FROM THE CONTROL OPERATOR TO CHANGE DIRECTION UNLESS A MOVEABLE PART OF THE INTERLOCKING LIES BETWEEN THE EAST END OF TRAIN AND THE NEXT SIGNAL IN ADVANCE&#13;</span></p></body>) /Rect [ 284.351 369.396 304.351 387.397 ] /Rotate 90 /Subj (6.4.2 MOVEMENTS WITHIN CONTROL POINTS OR INTERLOCKINGS) /Subtype /Text /T (RID OPS PRO) /Type /Annot >>
endobj
